{
  "name": "frontend",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "backend": "cd ../backend && venv\\Scripts\\activate && python app.py",
    "dev:all": "npx concurrently \"npm run dev\" \"npm run backend\"",
    "stop": "taskkill /FI \"WINDOWTITLE eq npm run dev\" /F && taskkill /FI \"WINDOWTITLE eq npm run backend\" /F",

    "build": "vite build",
    "preview": "vite preview"
  },

  "dependencies": {
    "axios": "^1.7.2",
    "vue": "^3.5.32",
    "vue-router": "^4.3.3"
  },

  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "vite": "^5.3.1",
    "concurrently": "^9.0.0"
  }
}
