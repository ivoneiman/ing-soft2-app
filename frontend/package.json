{
  "name": "frontend",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "backend": "cd ../backend && venv\\Scripts\\activate && python app.py",
    "dev:all": "npx concurrently \"npm run dev\" \"npm run backend\"",
    "stop": "taskkill /FI \"WINDOWTITLE eq npm run dev\" /F && taskkill /FI \"WINDOWTITLE eq npm run backend\" /F",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "axios": "^1.7.2",
    "html5-qrcode": "^2.3.8",
    "qrcode.vue": "^3.9.1",
    "vue": "^3.5.32",
    "vue-router": "^4.3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "concurrently": "^9.0.0",
    "vite": "^8.0.14"
  }
}
