# ═══════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE LA APLICACIÓN - DESARROLLO LOCAL
# ═══════════════════════════════════════════════════════════════════════════
# Copiar este archivo a .env y ajustar valores si es necesario

# ─── Autenticación ────────────────────────────────────────────────────────────

# Clave secreta para sesiones y tokens
# IMPORTANTE: En desarrollo local puede ser cualquier valor.
# En producción, DEBE ser una cadena fuerte y secreta.
SECRET_KEY=dev-secret-key

# ─── Base de Datos ────────────────────────────────────────────────────────────

# SQLite para desarrollo local (recomendado)
# Archivo local que se crea automáticamente al ejecutar la app
# No requiere servidor externo
# DEFAULT: sqlite:///app.db (en directorio actual)
SQLALCHEMY_DATABASE_URI=sqlite:///app.db

# Para cambiar a PostgreSQL (no recomendado para desarrollo local):
# SQLALCHEMY_DATABASE_URI=postgresql://usuario:contraseña@localhost:5432/nombre_db
# IMPORTANTE: Requiere instalar psycopg en requirements.txt y servidor PostgreSQL

# ─── CORS ─────────────────────────────────────────────────────────────────────

# Orígenes permitidos para requests desde frontend
# En desarrollo local, Vite usa puerto 5173
CORS_ORIGINS=http://localhost:5173

# ─── Entorno ───────────────────────────────────────────────────────────────────

# Ambiente de ejecución
ENVIRONMENT=development

# Flask debug mode (solo para desarrollo)
FLASK_DEBUG=1
FLASK_ENV=development

# ─── Mercado Pago ───────────────────────────────────────────────────────────

# Credenciales Sandbox/Test de Mercado Pago:
# Agregar las credenciales que les mande!!!!!!!

MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# Modo checkout:
# sandbox | production
MERCADOPAGO_CHECKOUT_MODE=sandbox

# ─── Emails transaccionales (Resend) ───────────────────────────────────────

# Cada desarrollador debe crear su cuenta en Resend y configurar su propia API key.
# No commitear claves reales en .env ni en este archivo.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# ─── Callbacks Mercado Pago ─────────────────────────────────────────────────

# IMPORTANTE:
# Mercado Pago NO acepta localhost para auto_return approved.
# Usar URLs HTTPS públicas (ngrok/cloudflared).

PAYMENT_SUCCESS_URL=
PAYMENT_FAILURE_URL=
PAYMENT_PENDING_URL=

# ─── Timezone ───────────────────────────────────────────────────────────────

# Timezone usada para descuentos y validaciones
APP_TIMEZONE=America/Argentina/Buenos_Aires
